# Quantum Electronics local environment
# Copy values into your shell environment or a local .env file ignored by git.

# KIS sample configuration. The YAML file contains app keys, account numbers,
# endpoints, and HTS ID. Do not commit the real file.
KIS_CONFIG_FILE=/absolute/path/to/kis_devlp.yaml
KIS_CONFIG_ROOT=/absolute/path/to/kis/config
KIS_TOKEN_PATH=/absolute/path/to/runtime/KIS_TOKEN

# DART Open API key. Leave unset to run collectors in disabled/fallback mode.
DISCLOSURE_CRTFC_KEY=

# Naver News API credentials. Leave unset to run news collection in disabled/fallback mode.
NAVER_NEWS_API_CLIENT=
NAVER_NEWS_API_SECRET=

# LLM provider key. Leave unset to use disabled/mock analysis paths.
OPENAI_API_KEY=

# Trading safety: real order flow must stay disabled by default.
ENABLE_REAL_TRADING=false
